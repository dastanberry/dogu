# Страница и скрипты всегда проверяются на свежесть — обновления видны сразу.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
DirectoryIndex index.html

# Языковые адреса: /dogu/lv/, /dogu/ru/, /dogu/en/ открывают тот же сайт.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:lv|ru|en)/?$ index.html [L]
  RewriteRule ^(?:lv|ru|en)/(.+)$ $1 [L]
</IfModule>
